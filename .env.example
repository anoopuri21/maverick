APP_NAME=Maverick
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Set to false to disable inferred validation rules on Filament text fields.
# FILAMENT_LENIENT_VALIDATION=true

# Only change these when deploying behind a known proxy or preview domain.
# TRUSTED_PROXIES=*
# APP_ALLOWED_URL_HOSTS=localhost,127.0.0.1,*.e2b.app

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Shared hosting production tip: prefer file drivers to cut MySQL load.
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# LOG_STACK=daily
# LOG_LEVEL=error
# LOG_DAILY_DAYS=7

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEDIA_MAX_UPLOAD_KB=5120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Permanent site images are stored on this server at storage/app/public/media
# (served at /storage/media after `php artisan storage:link`).
MEDIA_STORAGE_DISK=public
MEDIA_STORAGE_PREFIX=media
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_REMOTE_DOWNLOAD_TIMEOUT=90

# Legacy migration only: keep these filled until `media:migrate-cloudinary`
# completes and the recovered site has been verified. New uploads do not use Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=maverick-academy
# CLOUDINARY_ENV_PREFIX=

ZAPIER_CONTACT_WEBHOOK_URL=

# Canonical origin and aliases used by redirects, canonical tags and sitemap.
PREFERRED_ORIGIN_URL=https://mbalondon.org.uk
PREFERRED_ORIGIN_HOSTS=mbalondon.org.uk,www.mbalondon.org.uk
CONTACT_FALLBACK_EMAIL=fazil@mbalondon.org.uk

# Public forms (contact, programme, MBA landing, event registration):
# keep disabled until all values are set for this deployment's hostname.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=mbalondon.org.uk,www.mbalondon.org.uk

VITE_APP_NAME="${APP_NAME}"
