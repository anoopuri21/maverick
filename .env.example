APP_NAME=Maverick
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Shared hosting production tip: prefer file drivers to cut MySQL load.
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# LOG_STACK=daily
# LOG_LEVEL=error
# LOG_DAILY_DAYS=7

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEDIA_MAX_UPLOAD_KB=5120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=maverick-academy
# CLOUDINARY_ENV_PREFIX=
# false = one shared folder for every environment (required for the account
# migration; the tooling hard-fails when this is true). Do not enable.
CLOUDINARY_ENV_FOLDER=false
# Stable disk_env label stored on media_assets rows in shared-folder mode.
CLOUDINARY_DISK_ENV=shared
# --- Cloudinary account migration (old -> new), Phase 1 ---
# Old account: only the cloud name is required (public-URL fetch is unsigned).
CLOUDINARY_SOURCE_CLOUD_NAME=
# CLOUDINARY_SOURCE_API_KEY=
# CLOUDINARY_SOURCE_API_SECRET=
# New account: full credentials (upload + Admin API for collision/verify).
CLOUDINARY_DEST_CLOUD_NAME=
CLOUDINARY_DEST_API_KEY=
CLOUDINARY_DEST_API_SECRET=
# Throttle between migration API calls (ms). Lower on fast servers only.
# MEDIA_MIGRATION_THROTTLE_MS=250

ZAPIER_CONTACT_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
